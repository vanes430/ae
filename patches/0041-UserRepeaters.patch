---
diff --git a/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java b/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java
--- a/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java	2026-07-30 10:27:31.660350051 +0000
+++ b/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java	2026-07-30 10:28:05.888658626 +0000
@@ -2,9 +2,9 @@
 
