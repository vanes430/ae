From: Shimazu <vanessimbolon2020@gmail.com>
Date: Fri, 31 Jul 2026 02:19:04 +0000
Subject: ItemBuilder: Replace deprecated ItemStack.setDurability with Damageable ItemMeta

AE PATCH REASON: ItemStack.setDurability and the 3-arg ItemStack(Material, int, short) constructor are deprecated and removed/no-op on modern Paper versions; durability now lives in Damageable ItemMeta.
AE PATCH FIX: Replace the legacy 3-arg ItemStack constructor with new ItemStack(Material, int) plus Damageable ItemMeta.setDamage applied when durability is above 0. Rewrite setDurability and setInfinityDurability to route through ItemMeta.setDamage instead of ItemStack.setDurability.
AE PATCH RISK: LOW - API: setDurability/legacy constructor → Damageable ItemMeta.setDamage. No behavior change.

---
diff --git a/net/advancedplugins/ae/impl/utils/items/ItemBuilder.java b/net/advancedplugins/ae/impl/utils/items/ItemBuilder.java
--- a/net/advancedplugins/ae/impl/utils/items/ItemBuilder.java	2026-07-30 10:27:31.678350213 +0000
+++ b/net/advancedplugins/ae/impl/utils/items/ItemBuilder.java	2026-07-31 00:51:19.109794148 +0000
@@ -97,7 +97,14 @@
    }
 
    public ItemBuilder(Material var1, int var2, byte var3) {
-      this.is = new ItemStack(var1, var2, (short)var3);
+      this.is = new ItemStack(var1, var2);
+      if (var3 > 0) {
+         ItemMeta meta = this.is.getItemMeta();
+         if (meta instanceof org.bukkit.inventory.meta.Damageable d) {
+            d.setDamage(var3);
+            this.is.setItemMeta(meta);
+         }
+      }
       this.im = this.is.getItemMeta();
    }
 
@@ -106,7 +113,11 @@
    }
 
    public ItemBuilder setDurability(short var1) {
-      this.is.setDurability(var1);
+      ItemMeta meta = this.is.getItemMeta();
+      if (meta instanceof org.bukkit.inventory.meta.Damageable d) {
+         d.setDamage(var1);
+         this.is.setItemMeta(meta);
+      }
       return this;
    }
 
@@ -162,7 +173,11 @@
    }
 
    public ItemBuilder setInfinityDurability() {
-      this.is.setDurability((short)32767);
+      ItemMeta meta = this.is.getItemMeta();
+      if (meta instanceof org.bukkit.inventory.meta.Damageable d) {
+         d.setDamage(32767);
+         this.is.setItemMeta(meta);
+      }
       return this;
    }
 
