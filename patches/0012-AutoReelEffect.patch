+   private void anchorHook(PlayerFishEvent event) {
+      if (event.getState() == State.BITE) {
+         Player player = event.getPlayer();
+         UUID playerUuid = player.getUniqueId();
+         this.cache.put(playerUuid, true);
+         FishHook hook = event.getHook();
+         player.getScheduler().run(EffectsHandler.getInstance(), scheduledTask -> {
+            this.cache.invalidate(playerUuid);
+            this.retrieveHook(player, hook, event.getHand());
+            Entity hookedEntity = hook.getHookedEntity();
+            State catchState = hookedEntity instanceof Fish ? State.CAUGHT_FISH : State.CAUGHT_ENTITY;
+            PlayerFishEvent catchEvent = new PlayerFishEvent(player, hookedEntity, hook, catchState);
+            Bukkit.getPluginManager().callEvent(catchEvent);
+         }, null);
