From: Folia Compatibility Patch
Subject: [PATCH 0012] TeleportEffect: Rename variables and use teleportAsync

AE PATCH REASON: Obfuscated variable names hinder maintainability.
AE PATCH FIX: Rename var1/var2/var3 to descriptive names. Replace teleport() with teleportAsync() for compatibility.
AE PATCH RISK: LOW

---
diff --git a/net/advancedplugins/ae/impl/effects/effects/effects/internal/TeleportEffect.java b/net/advancedplugins/ae/impl/effects/effects/effects/internal/TeleportEffect.java
--- a/net/advancedplugins/ae/impl/effects/effects/effects/internal/TeleportEffect.java	2026-07-30 10:27:31.667350114 +0000
+++ b/net/advancedplugins/ae/impl/effects/effects/effects/internal/TeleportEffect.java	2026-07-30 10:28:05.878658536 +0000
@@ -6,17 +6,17 @@
 import org.bukkit.plugin.java.JavaPlugin;
 
 public class TeleportEffect extends AdvancedEffect {
-   public TeleportEffect(JavaPlugin var1) {
-      super(var1, "TELEPORT", "Teleport to location", "%e");
+   public TeleportEffect(JavaPlugin plugin) {
+      super(plugin, "TELEPORT", "Teleport to location", "%e");
    }
 
    @Override
-   public boolean executeEffect(ExecutionTask var1, Location var2, String[] var3) {
-      Location var4 = var2.clone();
-      Location var5 = var1.getBuilder().getMain().getLocation();
-      var4.setYaw(var5.getYaw());
-      var4.setPitch(var5.getPitch());
-      var1.getBuilder().getMain().teleport(var4);
+   public boolean executeEffect(ExecutionTask task, Location targetLocation, String[] args) {
+      Location teleportLocation = targetLocation.clone();
+      Location playerLocation = task.getBuilder().getMain().getLocation();
+      teleportLocation.setYaw(playerLocation.getYaw());
+      teleportLocation.setPitch(playerLocation.getPitch());
+      task.getBuilder().getMain().teleportAsync(teleportLocation);
       return true;
    }
 }
