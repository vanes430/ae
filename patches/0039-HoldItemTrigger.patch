+    public void onInvClick(InventoryClickEvent event) {
+       Player player = (Player)event.getWhoClicked();
+       int slot = event.getSlot();
+       int heldSlot = player.getInventory().getHeldItemSlot();
+       ItemStack currentItem = event.getCurrentItem();
+       ItemStack cursor = event.getCursor();
+       switch (event.getAction()) {
+          case HOTBAR_SWAP:
+             if (heldSlot == event.getHotbarButton() && event.getHotbarButton() != -1) {
+                this.executeCheck(player, player.getInventory().getItem(event.getHotbarButton()), currentItem);
+             } else {
+                if (slot == 40 && MinecraftVersion.getVersionNumber() >= 1160 && event.getClick() == ClickType.SWAP_OFFHAND) {
+                   return;
+                }
+
+                if (MinecraftVersion.getVersionNumber() >= 1160 && event.getClick() == ClickType.SWAP_OFFHAND) {
+                   this.executeOffhandCheck(player, player.getInventory().getItemInOffHand(), currentItem);
+                }
+             }
+             break;
+          case HOTBAR_MOVE_AND_READD:
+             if (event.getHotbarButton() != -1) {
+                this.executeCheck(player, player.getInventory().getItem(event.getHotbarButton()), currentItem);
+             }
+             break;
+          case SWAP_WITH_CURSOR:
+             if (heldSlot == event.getHotbarButton() && event.getHotbarButton() != -1) {
+                this.executeCheck(player, player.getInventory().getItem(event.getHotbarButton()), currentItem);
+             }
+             break;
+          case MOVE_TO_OTHER_INVENTORY:
+             if (!(event.getInventory() instanceof PlayerInventory) && heldSlot != slot) {
+                player.getScheduler().runDelayed(EffectsHandler.getInstance(), task -> this.executeCheck(player, null, player.getItemInHand()), null, 1L);
+             } else if (heldSlot == slot) {
+                this.executeCheck(player, currentItem, null);
+             }
+       }
+
+       if (currentItem != null) {
+          if (event.getClickedInventory() instanceof PlayerInventory) {
+             if (slot == heldSlot) {
+                this.executeCheck(player, currentItem, cursor);
+             }
+
+             if (slot == 40) {
+                ItemStack cursorClone = cursor.clone();
+                ItemStack offHandClone = player.getInventory().getItemInOffHand().clone();
+                player.getScheduler().runDelayed(EffectsHandler.getInstance(), task -> {
+                   if (cursorClone.equals(player.getInventory().getItemInOffHand())) {
+                      this.executeOffhandCheck(player, offHandClone, cursorClone);
+                   }
+                }, null, 1L);
+             }
+          }
+        } else if (cursor != null && slot == heldSlot) {
+          if (event.getSlotType().equals(SlotType.QUICKBAR) && event.getHotbarButton() == -1) {
+             this.executeCheck(player, null, cursor);
+          } else {
+             this.executeCheck(player, cursor, null);
+          }
+       }
    }
 
