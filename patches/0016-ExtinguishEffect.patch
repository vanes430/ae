From: Folia Compatibility Patch
Subject: [PATCH 0016] ExtinguishEffect: Migrate potion, boost, extinguish, guard, and teleport effects to SchedulerUtils/FoliaScheduler

AE PATCH REASON: Standard enchantment effects use legacy scheduler
AE PATCH FIX: Migrate potion, boost, extinguish, guard, and teleport effects to SchedulerUtils/FoliaScheduler
AE PATCH RISK: MEDIUM
AE PATCH EXCLUDES: net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect.class, net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect$*.class

---
diff --git a/net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect.java b/net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect.java
index 38a20dd..d1f39fb 100644
--- a/net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect.java
+++ b/net/advancedplugins/ae/impl/effects/effects/effects/internal/ExtinguishEffect.java
@@ -2,7 +2,7 @@ package net.advancedplugins.ae.impl.effects.effects.effects.internal;
 
 import net.advancedplugins.ae.impl.effects.effects.actions.execution.ExecutionTask;
 import net.advancedplugins.ae.impl.effects.effects.effects.AdvancedEffect;
-import net.advancedplugins.ae.impl.utils.SchedulerUtils;
+import net.advancedplugins.ae.impl.utils.ASManager;
 import org.bukkit.entity.LivingEntity;
 import org.bukkit.plugin.java.JavaPlugin;
 
@@ -12,7 +12,7 @@ public class ExtinguishEffect extends AdvancedEffect {
    }
 
    public boolean executeEffect(ExecutionTask task, LivingEntity target, String[] args) {
-      SchedulerUtils.runTaskLater(() -> target.setFireTicks(0), 1L);
+      target.getScheduler().runDelayed(ASManager.getInstance(), t -> target.setFireTicks(0), null, 1L);
       return true;
    }
 }

