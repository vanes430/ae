From: Folia Compatibility Patch
Subject: [PATCH 0018] ReloadEvent: Migrate Bukkit scheduler to GlobalRegionScheduler

AE PATCH REASON: Bukkit.getScheduler() is incompatible with Folia server architecture.
AE PATCH FIX: Replace Bukkit.getScheduler().runTaskLater() with Bukkit.getGlobalRegionScheduler().runDelayed(). Rename event variable.
AE PATCH RISK: LOW

---
diff --git a/net/advancedplugins/ae/globallisteners/listeners/ReloadEvent.java b/net/advancedplugins/ae/globallisteners/listeners/ReloadEvent.java
--- a/net/advancedplugins/ae/globallisteners/listeners/ReloadEvent.java	2026-07-30 10:27:31.684350267 +0000
+++ b/net/advancedplugins/ae/globallisteners/listeners/ReloadEvent.java	2026-07-30 10:28:05.898658717 +0000
@@ -9,10 +9,9 @@
 
 public class ReloadEvent implements Listener {
    @EventHandler
-   public void reloadEvent(ServerLoadEvent var1) {
-      if (var1.getType() == LoadType.RELOAD) {
-         Bukkit.getScheduler().runTaskLater(Core.getInstance(), () -> Bukkit.getOnlinePlayers().forEach(var0 -> {
-            }), 2L);
+   public void reloadEvent(ServerLoadEvent e) {
+      if (e.getType() == LoadType.RELOAD) {
+         Bukkit.getGlobalRegionScheduler().runDelayed(Core.getInstance(), (task) -> Bukkit.getOnlinePlayers().forEach(p -> {}), 2L);
       }
    }
 }
