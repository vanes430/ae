From: Folia Compatibility Patch
Subject: [PATCH 0019] UserRepeaters: Migrate RepeatingTrigger and UserRepeaters to FoliaScheduler.Task

AE PATCH REASON: Repeating enchantment triggers use incompatible BukkitTask management
AE PATCH FIX: Migrate RepeatingTrigger and UserRepeaters to FoliaScheduler.Task
AE PATCH RISK: HIGH
AE PATCH EXCLUDES: net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.class, net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters$*.class

---
diff --git a/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java b/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java
index 82df3ed..9ce6c02 100644
--- a/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java
+++ b/net/advancedplugins/ae/impl/effects/effects/mechanics/triggers/internal/UserRepeaters.java
@@ -2,9 +2,9 @@ package net.advancedplugins.ae.impl.effects.effects.mechanics.triggers.internal;
 
 import java.util.HashMap;
 import java.util.List;
+import io.papermc.paper.threadedregions.scheduler.ScheduledTask;
 import org.bukkit.inventory.EquipmentSlot;
-import org.bukkit.scheduler.BukkitTask;
 
 class UserRepeaters {
-   public final HashMap<EquipmentSlot, List<BukkitTask>> itemRunnables = new HashMap<>();
+   public final HashMap<EquipmentSlot, List<ScheduledTask>> itemRunnables = new HashMap<>();
 }

